# Copy this file to ".env" and fill in your values.

# Base URL of the fall-detection API.
# - local same machine:  http://localhost:8090
# - external (ngrok):     https://xxxx-xx-xx.ngrok-free.app   (changes each restart)
VITE_FALL_API_BASE=http://localhost:8090

# Default room shown if the API doesn't send a room_id.
VITE_DEFAULT_ROOM=ROOM-101

# How often to poll /api/status, in milliseconds.
VITE_POLL_MS=1500
